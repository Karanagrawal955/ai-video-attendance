# ===========================================================================
# AI Video Attendance - environment configuration (copy to `.env`)
#
#   cp .env.example .env
#
# Every value below is read by app/config.py.  Local defaults assume you run
# PostgreSQL/Redis on localhost.  `docker compose` OVERRIDES DATABASE_URL and
# REDIS_URL to the in-network service names - the rest of the file is shared.
# ===========================================================================

# ------------------------------------------------------------------- app ---
APP_NAME="AI Video Attendance API"
ENVIRONMENT=development
LOG_LEVEL=INFO
# json = one JSON object per line (grep-able inference timings); text = pretty
LOG_FORMAT=json
# Browser origins allowed to call the API (comma separated, or *)
CORS_ORIGINS=*
# Where enrolled reference photos are stored (compose maps this to ./data)
DATA_DIR=./data
# Used to decide which calendar day a timestamp belongs to (attendance dates)
LOCAL_TIMEZONE=Asia/Kolkata

# -------------------------------------------------------------- database ---
# Local development (compose overrides with postgres:5432)
DATABASE_URL=postgresql+psycopg://attendance:attendance@localhost:5432/attendance

# ----------------------------------------------------------------- redis ---
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ auth ---
# false = no JWT required (handy while building your frontend)
AUTH_REQUIRED=true
# REQUIRED: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# Admin/staff credentials for POST /auth/token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ------------------------------------------------------- face model / GPU ---
FACE_MODEL_NAME=buffalo_l
# Model cache directory (compose maps this to the insightface_models volume)
INSIGHTFACE_ROOT=~/.insightface
# Which GPU to use when several are present
CUDA_DEVICE_INDEX=0
# true = skip CUDA entirely (debugging / CPU-only hosts)
FORCE_CPU=false
# Detection input size(s): 640x640 = fastest; add 128x128 for small faces
DET_SIZES=640x640
DET_THRESH=0.5
# Push N frames through SCRFD in one session.run (auto-disabled if the
# exported ONNX graph has a static batch of 1 - check /system/gpu-status)
ENABLE_BATCHED_DETECTION=true
MAX_FACES_PER_FRAME=20
# Faces per GPU call when batching ArcFace embeddings across frames
MAX_EMBEDDING_BATCH=64

# ----------------------------------------------------------- recognition ---
# Cosine similarity needed to accept a match (buffalo_l: 0.35-0.45 typical;
# raise to 0.45+ to reduce false accepts)
RECOGNITION_THRESHOLD=0.40
# Same student + camera within this window => single event (spec: 2 minutes)
DEDUP_WINDOW_SECONDS=120
# true = still write RecognitionLog rows even when dedup suppresses the event
DEDUP_LOG_ALL=false
# true = log unknown faces too (audit-heavy on busy gates)
LOG_UNKNOWN_FACES=false
MIN_REFERENCE_PHOTOS=3
MAX_REFERENCE_PHOTOS=5

# ---------------------------------------------------- shared inference RPC ---
# redis     = worker/API call the shared `inference` service (default, one GPU model)
# inprocess = worker loads the model itself (debug only; needs GPU on worker)
INFERENCE_MODE=redis
INFERENCE_QUEUE_KEY=infer:requests
INFERENCE_RESPONSE_TTL_S=30
INFERENCE_REQUEST_TIMEOUT_S=15
# Max frames the GPU service merges into ONE engine call (across all cameras)
MAX_BATCH_FRAMES=32
# How long it waits to fill that batch before running anyway
INFERENCE_BATCH_WAIT_MS=25

# --------------------------------------------------------------- pipeline ---
# Process every Nth decoded frame (5 => ~6 FPS from a 30 FPS stream)
DEFAULT_SAMPLING_RATE=5
# Bounded decode queue per camera (drop-oldest, keeps latency flat)
FRAME_QUEUE_SIZE=8
# Frames per Redis RPC sent by one camera worker
BATCH_SIZE=8
# Max wait to fill a camera-side batch (ms)
BATCH_FLUSH_MS=120
JPEG_QUALITY=85
# rtsp_transport: tcp (reliable) or udp (lower latency)
RTSP_TRANSPORT=tcp
RTSP_OPEN_TIMEOUT_MS=10000
RTSP_READ_TIMEOUT_MS=10000
RECONNECT_INITIAL_DELAY_S=2
RECONNECT_MAX_DELAY_S=30
# Dedicated Celery worker slots for concurrent camera streams
CAMERA_SLOTS=8
# Pipeline heartbeat TTL; expired => /cameras reports `unhealthy`
HEARTBEAT_TTL_S=30

# ------------------------------------------------------------------ seed ---
# Mock camera source used by scripts/seed.py when --video is omitted
SEED_VIDEO_PATH=./samples/videos/lecture.mp4

# ------------------------------------------------------------ docker only ---
# (used by docker-compose.yml interpolation - not read by the app)
POSTGRES_PASSWORD=attendance
API_PORT=8000
API_WORKERS=1
# Newest CUDA-12 build is 1.26.0; use 1.27+ only with driver >= 580 + CUDA 13 base
ORT_GPU_VERSION=1.26.0
